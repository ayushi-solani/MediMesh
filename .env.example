# Default: fully working LOCAL DEMO. No Firebase project or credentials required.
NEXT_PUBLIC_APP_MODE=demo

# Change NEXT_PUBLIC_APP_MODE=firebase after configuring all Firebase values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
# For Vercel, enter the private key with literal \n in the environment variable.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

